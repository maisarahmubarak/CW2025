<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.comp2042.SettingsController" styleClass="menu-root" prefWidth="400" prefHeight="300">
    <VBox spacing="20" alignment="CENTER" styleClass="menu-panel" StackPane.alignment="CENTER">
        <Label text="SETTINGS" styleClass="mode-selection-title"/>
        
        <VBox spacing="5" alignment="CENTER">
            <Label text="Brightness" styleClass="settings-label"/>
            <Slider fx:id="brightnessSlider" min="0" max="1" value="1" blockIncrement="0.1" maxWidth="200"/>
        </VBox>

        <VBox spacing="5" alignment="CENTER">
            <Label text="Volume" styleClass="settings-label"/>
            <Slider fx:id="volumeSlider" min="0" max="100" value="50" blockIncrement="10" maxWidth="200"/>
        </VBox>

        <HBox spacing="12" alignment="CENTER">
            <Button text="Back" onAction="#onBack" styleClass="menu-button, cancel-button"/>
        </HBox>
    </VBox>
    <stylesheets>
        <URL value="@window_style.css"/>
    </stylesheets>
</StackPane>
