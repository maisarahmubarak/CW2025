<?import com.comp2042.ui.overlay.GameOverPanel?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>
<StackPane fx:id="rootPane" fx:controller="com.comp2042.ui.GuiController"
      xmlns:fx="http://javafx.com/fxml" styleClass="game-root"
      prefWidth="700" prefHeight="600">
    <?import javafx.scene.control.Label?>
    <?import javafx.scene.layout.VBox?>
    <AnchorPane fx:id="contentPane">
        <GridPane fx:id="brickPanel" vgap="1" hgap="1" styleClass="active-brick-overlay"/>
    <VBox layoutX="520" layoutY="30" prefWidth="140" alignment="CENTER" styleClass="vbox">
        <Label text="NEXT" styleClass="nextBrickLabel"/>
        <GridPane fx:id="previewPanel" hgap="1" vgap="1" styleClass="preview-panel"/>
    </VBox>
        <BorderPane styleClass="gameBoard" fx:id="gameBoard" layoutX="240" layoutY="30" prefWidth="215" prefHeight="520">
        <center>
            <StackPane fx:id="boardStack" BorderPane.alignment="TOP_LEFT">
                <GridPane fx:id="gamePanel" hgap="1" vgap="1" prefWidth="209" prefHeight="514"/>
            </StackPane>
        </center>
    </BorderPane>
    <VBox layoutX="25" layoutY="30" prefWidth="190" alignment="CENTER" spacing="5">
        <Label text="HIGH SCORE" styleClass="nextBrickLabel"/>
        <VBox styleClass="info-panel" alignment="CENTER">
            <Label fx:id="highScoreLabel" text="0" styleClass="scoreClass"/>
        </VBox>
    </VBox>
    <VBox layoutX="25" layoutY="140" prefWidth="190" alignment="CENTER" spacing="5">
        <Label text="SCORE" styleClass="nextBrickLabel"/>
        <VBox styleClass="info-panel" alignment="CENTER">
            <Label fx:id="scoreLabel" text="0" styleClass="scoreClass"/>
        </VBox>
    </VBox>
    <VBox layoutX="25" layoutY="250" prefWidth="190" alignment="CENTER" spacing="5">
        <Label text="TIME" styleClass="nextBrickLabel"/>
        <VBox styleClass="info-panel" alignment="CENTER">
            <Label fx:id="timerLabel" text="00:00" styleClass="scoreClass"/>
        </VBox>
    </VBox>
    </AnchorPane>
    <AnchorPane fx:id="groupNotification">
        <VBox alignment="CENTER">
            <GameOverPanel fx:id="gameOverPanel"/>
        </VBox>
    </AnchorPane>
    <stylesheets>
        <URL value="@window_style.css"/>
    </stylesheets>
</StackPane>